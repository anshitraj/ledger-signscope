# SignScope — Environment Configuration
# Copy: cp .env.example .env
# Then add your GEMINI_API_KEY and restart the server.

# ── Gemini AI (REQUIRED) ──────────────────────────────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
# Without this key the main pipeline (POST /api/request-check/run) will fail
# with a clear error. There is NO silent fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── App mode ─────────────────────────────────────────────────────────────────
APP_MODE=local
AI_AGENT_MODE=gemini

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3001
VITE_API_BASE_URL=http://localhost:3001/api

# ── Wallet CLI ───────────────────────────────────────────────────────────────
# Install: npm i -g @ledgerhq/wallet-cli
WALLET_CLI_BIN=wallet-cli
DEFAULT_NETWORK=ethereum
DEFAULT_ACCOUNT_LABEL=ethereum-1

# ── Ledger CLI gating ─────────────────────────────────────────────────────────
# Set to true to execute real wallet-cli commands (dry-run allowed).
# Default: false → returns honest "CLI not enabled" response, no fake output.
ENABLE_REAL_LEDGER_CLI=false

# ── Real signing (default: OFF) ───────────────────────────────────────────────
# Set to true ONLY when connected to a Ledger device or Speculos.
# Requires ENABLE_REAL_LEDGER_CLI=true AND explicit UI confirmation phrase.
ENABLE_REAL_SIGNING=false

# ── Storage ───────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./data/audit-logs.json
SETTINGS_PATH=./data/settings.json
